agri:CassavaBrownStreakVirus a agri:Pathogen ;
    rdfs:label "Cassava Brown Streak Virus" ;
    agri:description "An ipomovirus associated with cassava brown streak disease." ;
    agri:scientificName "Cassava brown streak virus (CBSV)" ;
    agri:transmittedBy agri:Whitefly .

agri:UgandanCassavaBrownStreakVirus a agri:Pathogen ;
    rdfs:label "Ugandan Cassava Brown Streak Virus" ;
    agri:description "An ipomovirus associated with cassava brown streak disease and reported as widespread in Rwanda." ;
    agri:scientificName "Ugandan cassava brown streak virus (UCBSV)" ;
    agri:transmittedBy agri:Whitefly .


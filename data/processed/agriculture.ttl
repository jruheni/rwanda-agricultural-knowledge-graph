agri:CassavaBrownStreakDisease a agri:Disease ;
    rdfs:label "Cassava Brown Streak Disease" ;
    agri:causedBy agri:CassavaBrownStreakVirus,
        agri:UgandanCassavaBrownStreakVirus ;
    agri:causesSymptom agri:CassavaLeafChlorosis,
        agri:CassavaRootConstrictions,
        agri:CassavaRootDiscolouration,
        agri:CassavaRootNecrosis,
        agri:CassavaStemLesions ;
    agri:description "A viral disease of cassava associated with leaf chlorosis, stem lesions, and necrotic damage in storage roots." ;
    agri:managedBy agri:CleanPlantingMaterial,
        agri:RemovalOfInfectedPlants,
        agri:TolerantVarieties .

